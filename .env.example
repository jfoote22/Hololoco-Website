# Copy to .env.local and fill in. Never commit real values.

# Mapbox public token (starts with "pk."), restricted to the site's own URLs. The map needs it.
# Never a secret token ("sk."): everything NEXT_PUBLIC_ ends up in the browser.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Hololoco's own Supabase project (Settings > API). Both are public by design; the
# database's rules decide what anyone can do. Without them: sample drops only, no sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "on" shows Continue with Google, once Google is set up in Supabase (Authentication > Providers).
NEXT_PUBLIC_GOOGLE_SIGN_IN=

# "off" hides the made-up sample drops.
NEXT_PUBLIC_SAMPLE_DROPS=
